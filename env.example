# Скопируй в файл .env на сервере (cp env.example .env) и заполни. Файл .env НЕЛЬЗЯ коммитить в репозиторий.

DOMAIN=api.example.com

POSTGRES_USER=app
# Пароль без спецсимволов: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=app

# Ключ подписи токенов: openssl rand -hex 32
SECRET_KEY=
# Одноразовый токен для создания первого пользователя: openssl rand -hex 16
SETUP_TOKEN=

# Где на сервере лежат файлы и база (отдельный расширяемый диск/том)
DATA_DIR=/srv/appdata
PGDATA_DIR=/srv/pgdata

# Необязательно
# MAX_UPLOAD_BYTES=21474836480
# TRASH_RETENTION_DAYS=30
# ENABLE_DOCS=false
