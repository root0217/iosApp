# Скопируй в файл .env на сервере (cp env.example .env) и заполни. Файл .env НЕЛЬЗЯ коммитить в репозиторий.

DOMAIN=api.example.com

POSTGRES_USER=app
# Пароль без спецсимволов: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=app

# Ключ подписи токенов и HMAC для recovery-кодов: openssl rand -hex 32
# Это не просто секрет для сессий — им же проверяются recovery-коды всех пользователей.
# Потерять или сменить его означает, что все существующие recovery-коды перестанут подходить.
SECRET_KEY=

# Где на сервере лежат файлы и база (отдельный расширяемый диск/том)
DATA_DIR=/srv/appdata
PGDATA_DIR=/srv/pgdata

# Необязательно
# MAX_UPLOAD_BYTES=21474836480
# TRASH_RETENTION_DAYS=30
# ENABLE_DOCS=false
